# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mint_training_system

# JWT Authentication
JWT_SECRET=your_super_secret_key_here_change_this
JWT_EXPIRE=7d

# Public base URL of the frontend. Certificate QR codes point at
# ${FRONTEND_URL}/verify/<certificate_number>
FRONTEND_URL=http://localhost:3000

# "Continue with Google" (OAuth2 authorization code flow).
#
# Create the credentials in Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth client ID -> "Web application". Add BOTH of these as authorised
# redirect URIs, exactly:
#   http://localhost:5000/api/auth/google/callback   (development)
#   https://<your-domain>/api/auth/google/callback  (production)
# The value must match GOOGLE_CALLBACK_URL below byte for byte, or Google
# rejects the code exchange.
#
# Leave both blank to disable the feature: the backend then reports the Google
# button as unavailable and the frontend hides it, while password login is
# completely unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Derived from the public API base URL when unset.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Forgot Password: how long an emailed reset link stays valid (minutes).
PASSWORD_RESET_EXPIRY_MINUTES=60

# Forgot Password OTP (6-digit code emailed alongside the link).
# OTP_PEPPER keys the HMAC that hashes one-time codes before they are stored.
# It MUST NOT live in the database: a 6-digit code has only 1,000,000 possible
# values, so an unkeyed hash can be brute-forced from a database dump in
# seconds. With the pepper held only in .env, a stolen dump is not enough.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every OTP already issued.
OTP_PEPPER=
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Forgot Password: local debugging only. When "true", the forgot-password
# response reports the real delivery outcome (account found, delivered, SMTP
# error code) so you can tell "mail sent" from "address undeliverable".
# OFF by default and it must stay OFF in production: reporting the true outcome
# turns the endpoint into an account-enumeration oracle.
PASSWORD_RESET_VERBOSE=false

# Forgot Password: outbound email. Leave SMTP_HOST empty in development and
# the reset link is printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@mint.gov.et
MAIL_FROM_NAME=MinT Training System

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/